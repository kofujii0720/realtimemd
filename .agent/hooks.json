{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": {
          "tools": ["write_to_file", "replace_file_content", "multi_replace_file_content"]
        },
        "command": "scripts/hooks/block-docs-edit.sh \"$TARGET_FILE\""
      }
    ],
    "Stop": [
      {
        "command": "scripts/hooks/stop-check-docs.sh"
      }
    ]
  }
}
